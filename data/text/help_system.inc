Help_Text_HowToUsePokedex::
	.string "{CIRCLE_1} Sélectionne “POKéDEX” sur le MENU.\n"
	.string "{CIRCLE_2} Choisis un POKéMON avec LISTE,\n"
	.string "   HABITATS ou RECHERCHE.\n"
	.string "{CIRCLE_3} Sélectionne un POKéMON pour avoir\n"
	.string "   des information détaillées.$"

Help_Text_HowToUsePokemon::
	.string "{CIRCLE_1} Sélectionne POKéMDN sur le menu.\n"
	.string "{CIRCLE_2} Choisis un POKéMON dans ton équipe\n"
	.string "{CIRCLE_3} Sélectionne “RESUME”, “ORDRE”,\n"
	.string "   ou “OBJET.”$"

Help_Text_HowToUseSummary::
	.string "{CIRCLE_1} Sélectionne “RESUME”.\n"
	.string "{CIRCLE_2} Appuie sur gauche ou droite sur\n"
	.string "   la manette {PLUS} pour choisir entre:\n"
	.string "   “INFOS POKéMON”\n"
	.string "   “APTITUDES”\n"
	.string "   “CAPACITES CONNUES”$"

Help_Text_HowToUseSwitch::
	.string "{CIRCLE_1} Choisis le POKéMDN que\n"
	.string "   tu veux déplacer.\n"
	.string "{CIRCLE_2} Sélectionne “ORDRE”.\n"
	.string "{CIRCLE_3} Choisis le POKéMON avec\n"
	.string "   lequel tu veux changer de place.\n"
	.string "Le POKéMON à la gauche de\n"
	.string "l'écran part au combat en premier.$"

Help_Text_HowToUseItem::
	.string "{CIRCLE_1} Sélectionne “OBJET”.\n"
	.string "{CIRCLE_2} Sélectionne “DONNER” pour\n"
	.string "   qu'un POKéMON porte un objet, ou\n"
	.string "   “PRENDR.” pour le récupérer.\n"
	.string "Un POKéMON ne peut pas porter\n"
	.string "plus d'un objet!$"

Help_Text_HowToUseBag::
	.string "{CIRCLE_1} Sélectionne “SAC” sur le MENU.\n"
	.string "{CIRCLE_2} Appuie sur gauche ou droite sur\n"
	.string "   la manette {PLUS} pour choisir entre:\n"
	.string "   “OBJETS”          “SOIN”\n"
	.string "   “OBJ. RARES”      “OBJET TENU”\n"
	.string "   “POKé BALLS”\n"
	.string "   Choisis un objet avec bas ou haut.$"

Help_Text_HowToUseAnItem::
	.string "{CIRCLE_1} Sélectionne la “POCHE OBJETS”.\n"
	.string "{CIRCLE_2} Choisis un objet avec haut et bas\n"
	.string "   sur la manette {PLUS}.\n"
	.string "{CIRCLE_3} Sélectionne “UTILIS.” pour utiliser\n"
	.string "   l'objet sélectionné.\n"
	.string "Certains objets sont inutilisables\n"
	.string "selon l'endroit ou la situation.$"

Help_Text_HowToUseKeyItem::
	.string "{CIRCLE_1} Sélectionne la “POCHE OBJ. RARES”.\n"
	.string "{CIRCLE_2} Choisis un objet avec haut et bas\n"
	.string "   sur la manette {PLUS}.\n"
	.string "{CIRCLE_3} Sélectionne “UTILIS.” pour utiliser\n"
	.string "   l'objet sélectionné.$"

Help_Text_HowToUsePokeBall::
	.string "{CIRCLE_1} Contre un POKéMON sauvage,\n"
	.string "   sélectionne la “POCHE POKé BALLS”.\n"
	.string "{CIRCLE_2} Choisis une POKé BALL avec haut\n"
	.string "   et bas sur la manette {PLUS}.\n"
	.string "{CIRCLE_3} Sélectionne “UTILIS.” pour lancer\n"
	.string "   la POKé BALL sélectionnée.$"

Help_Text_HowToUsePlayer::
	.string "{CIRCLE_1} Sélectionne “{PLAYER}” sur le MENU.\n"
	.string "{CIRCLE_2} Ta CARTE DRESSEUR\n"
	.string "   s'affiche avec les infos de base.\n"
	.string "   Appuie sur le bouton A pour.\n"
	.string "   retourner la carte.\n"
	.string "{CIRCLE_3} Diverses infos sont visibles sur\n"
	.string "   l'autre face.$"

Help_Text_HowToUseSave::
	.string "{CIRCLE_1} Sélectionne “SAUVER” sur le MENU.\n"
	.string "{CIRCLE_2} Sélectionne “OUI” pour\n"
	.string "   sauvegarder ta progression.\n"
	.string "La console peut être éteinte une\n"
	.string "fois la partie sauvegardée. La\n"
	.string "partie reprend depuis la dernière\n"
	.string "sauvegarde.$"

Help_Text_HowToUseOption::
	.string "{CIRCLE_1} Sélectionne “OPTIONS” sur le MENU.\n"
	.string "{CIRCLE_2} Fais un choix avec haut et bas\n"
	.string "   sur la manette {PLUS} et modifie les\n"
	.string "   paramètres avec gauche et droite.\n"
	.string "{CIRCLE_3} Sélectionne RETOUR ou appuie\n"
	.string "   sur le bouton B après avoir effectué\n"
	.string "   des changements.$"

Help_Text_HowToUsePotion::
	.string "{CIRCLE_1} Ouvre le MENU.\n"
	.string "{CIRCLE_2} Appuie sur haut ou bas sur\n"
	.string "   la manette {PLUS} et sélectionne “SAC”.\n"
	.string "{CIRCLE_3} Sélectionne “POTION” dans la POCHE OBJETS.\n"
	.string "{CIRCLE_4} Sélectionne “UTILIS.”\n"
	.string "{CIRCLE_5} Sélectionne le POKéMON à soigner.$"

Help_Text_HowToUseTownMap::
	.string "{CIRCLE_1} Ouvre le MENU.\n"
	.string "{CIRCLE_2} Appuie sur haut ou bas sur\n"
	.string "   la manette {PLUS} et sélectionne “SAC.”\n"
	.string "{CIRCLE_3} Appuie sur gauche ou droite\n"
	.string "   pour ouvrir la “POCHE OBJ. RARES”\n"
	.string "   puis haut ou bas pour sélectionner “CARTE.” \n"
	.string "{CIRCLE_4} Sélectionne “UTILIS.” pour ouvrir la CARTE.$"

Help_Text_HowToUseTM::
	.string "{CIRCLE_1} Ouvre le MENU.\n"
	.string "{CIRCLE_2} Ouvre la “POCHE OBJ. RARES” dans\n"
	.string "   le “SAC.”\n"
	.string "{CIRCLE_3} “OUVRE” la BOITE CT.\n"
	.string "{CIRCLE_4} Sélectionne et “UTILIS” la CT.\n"
	.string "{CIRCLE_5} Sélectionne le POKéMON qui peut\n"
	.string "   apprendre la CT.$"

Help_Text_HowToUseHM::
	.string "{CIRCLE_1} Ouvre le MENU.\n"
	.string "{CIRCLE_2} Ouvre la “POCHE OBJ. RARES” dans\n"
	.string "   le “SAC.”\n"
	.string "{CIRCLE_3} “OUVRE” la BOITE CT.\n"
	.string "{CIRCLE_4} Sélectionne et “UTILIS” la CS.\n"
	.string "{CIRCLE_5} Sélectionne le POKéMON qui peut\n"
	.string "   apprendre la CS.$"

Help_Text_HowToUseMoveOutsideOfBattle::
	.string "{CIRCLE_1} Ouvre le MENU.\n"
	.string "{CIRCLE_2} Sélectionne “POKéMON.”\n"
	.string "{CIRCLE_3} Sélectionne un POKéMON qui connait\n"
	.string "   une CS. Une CS utilisable\n"
	.string "   sera affichée en bleu. Sélectionne\n"
	.string "   la CS désirée et utilise son effet:\n"
	.string "   couper, voler, surfer, etc.$"

Help_Text_HowToRideBicycle::
	.string "{CIRCLE_1} Ouvre le MENU. Ouvre la\n"
	.string "   “POCHE OBJ. RARES” dans le “SAC”\n"
	.string "   et sélectionne la “BICYCLETTE.”\n"
	.string "{CIRCLE_2} La BICYCLETTE peut être utilisée\n"
	.string "   avec le bouton “UTILIS.” Vous pouvez\n"
	.string "   l'“ENREGISTRER” pour l'utiliser\n"
	.string "   rapidement avec le bouton SELECT.$"

Help_Text_HowToEnterName::
	.string "{CIRCLE_1} Bouge le curseur vers la lettre\n"
	.string "   désirée avec la manette {PLUS},\n"
	.string "   puis appuie sur le bouton A.\n"
	.string "{CIRCLE_2} Appuie sur B pour supprimer.\n"
	.string "{CIRCLE_3} Appuie sur SELECT pour passer\n"
	.string "   de majuscule à minuscule.\n"
	.string "{CIRCLE_4} Appuie sur le bouton A sur “OK.”$"

Help_Text_HowToUsePC::
	.string "{CIRCLE_1} Dans un centre POKéMON,\n"
	.string "   mets-toi face à un PC et appuie sur\n"
	.string "   le bouton A.$"

Help_Text_HowToUseBillsPC::
	.string "{CIRCLE_1} Sélectionne “PC DE {STR_VAR_1}” sur le PC.\n"
	.string "{CIRCLE_2} Sélectionne une des trois\n"
	.string "   commandes pour accéder à la\n"
	.string "   GESTION DE STOCKS DE POKéMON.\n"
	.string "Si tu attrapes un POKéMON en plus\n"
	.string "des six de ton équipe, il est envoyé\n"
	.string "directement dans une BOITE.$"

Help_Text_HowToUseWithdraw::
	.string "{CIRCLE_1} Sélectionne un POKéMON dans la\n"
	.string "   BOITE avec la manette {PLUS}.\n"
	.string "{CIRCLE_2} Sélectionne RETIRER pour\n"
	.string "   l'ajouter dans ton équipe.\n"
	.string "   Tu ne peux pas retirer de POKéMON\n"
	.string "si tu en as déjà six dans ton équipe.$"

Help_Text_HowToUseDeposit::
	.string "{CIRCLE_1} Sélectionne un POKéMON de ton\n"
	.string "   équipe avec la manette {PLUS}.\n"
	.string "{CIRCLE_2} Sélectionne “DEPOSER.”\n"
	.string "{CIRCLE_3} Choisis une BOITE et appuie sur\n"
	.string "   le bouton A pour déposer le POKéMON.\n"
	.string "Si tu n'as qu'un POKéMON, tu ne peux\n"
	.string "pas le déposer dans une BOITE.$"

Help_Text_HowToUseMove::
	.string "{CIRCLE_1} Sélectionne un POKéMON.\n"
	.string "{CIRCLE_2} Prends le POKéMON en\n"
	.string "   sélectionnant “DEPLACER” et change-le\n"
	.string "   de place avec la manette {PLUS}.\n"
	.string "{CIRCLE_3} Place le POKéMON sur le nom\n"
	.string "   de la BOITE et appuie sur gauche\n"
	.string "   ou droite pour changer de BOITE.$"

Help_Text_HowToMoveItems::
	.string "{CIRCLE_1} Les POKéMON apparaissant en\n"
	.string "   transparence peuvent porter un objet\n"
	.string "   sélectionné avec le bouton A.\n"
	.string "{CIRCLE_2} Les POKéMON apparaissant\n"
	.string "   clairement peuvent donner l'objet\n"
	.string "   qu'ils portent ou le déposer dans le\n"
	.string "   SAC en appuyant sur le bouton A.$"

Help_Text_HowToUsePlayersPC::
	.string "{CIRCLE_1} Sélectionne “PC DE {PLAYER}” sur le PC.\n"
	.string "{CIRCLE_2} Sélectionne “STOCKAGE OBJ.” ou\n"
	.string "   “BOITE LETTR.”\n"
	.string "Tu peux utiliser ton PC pour stocker\n"
	.string "ou retirer des OBJETS selon la place\n"
	.string "restant dans ton sac.$"

Help_Text_HowToUseWithdrawItem::
	.string "{CIRCLE_1} Sélectionne “RETIRER OBJET.”\n"
	.string "{CIRCLE_2} Sélectionne l'objet à retirer.\n"
	.string "{CIRCLE_3} L'objet peut être retiré ou placé\n"
	.string "   dans la POCHE OBJET DU SAC.\n"
	.string "   Il peut aussi être donné directement\n"
	.string "   à un POKéMON pour être porté.$"

Help_Text_HowToUseDepositItem::
	.string "{CIRCLE_1} Sélectionne “DEPOSER OBJET.”\n"
	.string "{CIRCLE_2} Sélectionne l'objet du SAC à\n"
	.string "   déposer avec la manette {PLUS}.\n"
	.string "{CIRCLE_3} S'il y a plus d'un objet à\n"
	.string "   déposer, entre la quantité avec la\n"
	.string "   manette {PLUS} et appuie sur le\n"
	.string "   bouton A.$"

Help_Text_HowToUseMailbox::
	.string "Une LETTRE prise à un POKéMON\n"
	.string "est déposée dans la BOITE AUX\n"
	.string "LETTRES. Sans LETTRE, la BOITE.\n"
	.string "n'est pas accessible.\n"
	.string "{CIRCLE_1} Sélectionne “PC DE {PLAYER}”.\n"
	.string "{CIRCLE_2} Sélectionne “BOITE LETTR.”\n"
	.string "   pour lire une LETTRE ou la donner.$"

Help_Text_HowToUseProfOaksPC::
	.string "{CIRCLE_1} Sélectionne “PC DU PROF. CHEN”.\n"
	.string "{CIRCLE_2} Le PROF. CHEN va évaluer\n"
	.string "   ton POKéDEX.\n"
	.string "Ses évalutations vont te donner\n"
	.string "des indices pour attraper d'autres\n"
	.string "POKéMON.$"

Help_Text_HowToOpenMenu::
	.string "{CIRCLE_1} Appuie sur START.\n"
	.string "{CIRCLE_2} Le menu apparaît sur la droite.\n"
	.string "{CIRCLE_3} Selon la situation, le MENU\n"
	.string "   peut avoir différentes commandes.\n"
	.string "Le MENU n'apparaît pas si tu\n"
	.string "marches, combats, etc.$"

Help_Text_HowToUseFight::
	.string "{CIRCLE_1} Sélectionne “ATTAQUE.”\n"
	.string "{CIRCLE_2} Sélectionne une des capacités\n"
	.string "indiquées pour lancer une attaque.$"

Help_Text_HowToUsePokemon2::
	.string "{CIRCLE_1} Sélectionne “POKéMON.”\n"
	.string "{CIRCLE_2} Sélection le POKéMON de\n"
	.string "   ton équipe que tu veux utiliser.\n"
	.string "{CIRCLE_3} Si tu as deux POKéMON ou\n"
	.string "   plus avec toi, tu peux changer leur\n"
	.string "   position avec “ECHANGER.”\n"
	.string "   Vérifie les données avec “RESUME.”$"

Help_Text_HowToUseShift::
	.string "Cette commande remplace le POKéMON\n"
	.string "au combat avec un autre de l'équipe.\n"
	.string "{CIRCLE_1} Coisis le POKéMON à envoyer.\n"
	.string "{CIRCLE_2} Sélectionne “ECHANGER.”\n"
	.string "{CIRCLE_3} Le POKéMON sélectionné va\n"
	.string "   remplacer celui au combat.$"

Help_Text_HowToUseSummary2::
	.string "{CIRCLE_1} Sélectionne “RESUME.”\n"
	.string "{CIRCLE_2} Appuie sur gauche ou droite sur\n"
	.string "   la manette {PLUS} pour choisir entre:\n"
	.string "   “INFOS POKéMON”\n"
	.string "   “APTITUDES”\n"
	.string "   “CAPACITES CONNUES”$"

Help_Text_HowToUseBag2::
	.string "{CIRCLE_1} Sélectionne “SAC” sur le menu\n"
	.string "{CIRCLE_2} Appuie sur gauche ou droite sur\n"
	.string "   la manette {PLUS} pour choisir entre:\n"
	.string "   “OBJETS”\n"
	.string "   “OBJ. RARES”\n"
	.string "   “POKé BALLS”\n"
	.string "   Choisis un objet avec bas ou haut.$"

Help_Text_HowToReadPokedex::
	.string "{CIRCLE_1} Les POKéMON déjà attrapés\n"
	.string "   sont identifiés par une POKé BALL\n"
	.string "   dans la liste du POKéDEX.\n"
	.string "{CIRCLE_2} Un POKéMON capturé fournit\n"
	.string "   un grand nombre d'informations.\n"
	.string "{CIRCLE_3} Sélectionne SUIVANT pour afficher\n"
	.string "   une CARTE des habitats du POKéMON.$"

Help_Text_HowToUseHomePC::
	.string "{CIRCLE_1} A la maison, va droit au PC et\n"
	.string "   appuie sur le bouton A.\n"
	.string "{CIRCLE_2} Le PC s'allume.\n"
	.string "{CIRCLE_3} Sélectionne “STOCKAGE OBJ.”\n"
	.string "   ou “BOITE LETTR.”$"

Help_Text_HowToUseItemStorage::
	.string "{CIRCLE_1} Sélectionne “RETIRER OBJET”\n"
	.string "   pour prendre un objet du PC.\n"
	.string "{CIRCLE_2} Sélectionne “DEPOSER OBJET”\n"
	.string "   pour mettre un objet de ton SAC\n"
	.string "   dans le PC.$"

Help_Text_HowToUseWithdrawItem2::
	.string "{CIRCLE_1} Sélectionne “RETIRER OBJET.”\n"
	.string "{CIRCLE_2} Sélectionne l'objet à retirer.\n"
	.string "{CIRCLE_3} L'objet peut être retiré ou placé\n"
	.string "   dans la POCHE OBJET du SAC.\n"
	.string "   Il peut aussi être donné directement\n"
	.string "   à un POKéMON pour être porté.$"

Help_Text_HowToUseDepositItem2::
	.string "{CIRCLE_1} Sélectionne “DEPOSER OBJET.”\n"
	.string "{CIRCLE_2} Sélectionne l'objet du SAC à\n"
	.string "   déposer avec la manette {PLUS}.\n"
	.string "{CIRCLE_3} Cette commande ne peut pas\n"
	.string "   être utilisée s'il n'y a rien dans le\n"
	.string "   SAC.$"

Help_Text_HowToUseMailbox2::
	.string "Une LETTRE prise à un POKéMON\n"
	.string "est déposée dans la BOITE AUX\n"
	.string "LETTRES. Sans LETTRE, la BOITE.\n"
	.string "n'est pas accessible.\n"
	.string "{CIRCLE_1} Sélectionne une LETTRE pour\n"
	.string "   la lire ou donne-la à un POKéMON.$"

Help_Text_HowToUseRun::
	.string "Tu ne peux pas choisir “FUITE” dans\n"
	.string "un combat contre un DRESSEUR!\n"
	.string "{CIRCLE_1} La “FUITE” n'est possible que\n"
	.string "contre un POKéMON sauvage.\n"
	.string "{CIRCLE_2} tes chances de fuir sont plus\n"
	.string "   grandes si ton POKéMON est rapide.$"

Help_Text_HowToRegisterKeyItem::
	.string "Tu peux “ENREGISTRER” un objet rare\n"
	.string "pour l'utiliser instantanément en\n"
	.string "appuyant sur SELECT.\n"
	.string "{CIRCLE_1} Ouvre la “POCHE OBJ. RARES.”\n"
	.string "{CIRCLE_2} Choisis un objet, puis\n"
	.string "   sélection “ENREG.”$"

Help_Text_HowToUseBall::
	.string "{CIRCLE_1} Contre un POKéMON sauvage,\n"
	.string "   sélectionne la POCHE POKé BALLS.\n"
	.string "{CIRCLE_2} Choisis une POKé BALL avec haut\n"
	.string "et bas sur la manette {PLUS}.\n"
	.string "{CIRCLE_3} Sélectionne UTILIS. pour lancer\n"
	.string "la POKé BALL sélectionnée.$"

Help_Text_HowToUseBait::
	.string "Pour lancer les appâts spéciaux\n"
	.string "utilisés au PARC SAFARI. C'est de\n"
	.string "la nourriture POKéMON mise en boule\n"
	.string "pour qu'ils la mangent facilement.\n"
	.string "Une fois l'appât lancé, les POKéMON\n"
	.string "sauvages sont attirés et ont moins de\n"
	.string "chances de fuir.$"

Help_Text_HowToUseRock::
	.string "Pour lancer une pierre au sol\n"
	.string "dans le PARC SAFARI.\n"
	.string "Cela peut faire fuir les POKéMON,\n"
	.string "mais dans le cas contraire, ils sont\n"
	.string "plus faciles à attraper!$"

Help_Text_HowToUseHallOfFame::
	.string "{CIRCLE_1} Sélectionne “PANTHEON” sur le PC.\n"
	.string "{CIRCLE_2} Les POKéMON qui ont été inscrits\n"
	.string "   au PANTHEON peuvent être consultés.$"

Help_Text_HowToUseKeySystemSettings::
	.string "{CIRCLE_1} Sélectionne “OPTIONS” sur le menu.\n"
	.string "{CIRCLE_2} Fais un choix avec haut et bas\n"
	.string "   sur la manette {PLUS} et modifie les\n"
	.string "   paramètres avec gauche ou droite.\n"
	.string "{CIRCLE_3} Sélectionne RETOUR ou appuie\n"
	.string "   sur le bouton B après avoir effectué\n"
	.string "   des changements.$"

Help_Text_HowToSortBag::
	.string "{CIRCLE_1} Appuie sur START après avoir ouvert le SAC.\n"
	.string "{CIRCLE_2} Fais un choix avec haut et bas\n"
	.string "   sur la manette {PLUS} et choisi le\n"
	.string "type de tri. Selon la poche tu peux\n"
	.string "trier par NOM, TYPE, NOMBRE, et\n"
	.string "IDENTIFIANT.$"

