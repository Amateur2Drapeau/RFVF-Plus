Help_Text_OwnMoveFighting::
	.string "Type de la capacité: COMBAT$"

Help_Text_OwnPokemonFighting::
	.string "Type du POKéMON: COMBAT$"

Help_Text_OwnMoveGrass::
	.string "Type de la capacité: PLANTE$"

Help_Text_OwnPokemonGrass::
