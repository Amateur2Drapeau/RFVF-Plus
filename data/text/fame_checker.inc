PokemonJournal_Text_SpecialFeatureBrock::
	.string "JOURNAL POKéMON\p"
	.string "Edition spéciale: ARENE D'ARGENTA\n"
	.string "PIERRE!\p"
	.string "PIERRE rigole rarement, mais il ne\n"
	.string "peut pas s'arrêter s'il commence.$"

PokemonJournal_Text_SpecialFeatureMisty::
	.string "JOURNAL POKéMON\p"
	.string "Edition spéciale: ARENE D'AZURIA\n"
	.string "ONDINE!\p"
	.string "On raconte qu'elle adore\n"
	.string "Olga du Conseil des 4.$"

PokemonJournal_Text_SpecialFeatureLtSurge::
	.string "JOURNAL POKéMON\p"
	.string "Edition spéciale: ARENE CARMIN SUR MER\n"
	.string "MAJOR BOB!\p"
	.string "Il aurait été pilote quand il était\n"
	.string "dans l'armée.\p"
	.string "Il utilisait l'électricité de ses\n"
	.string "POKéMON pour faire voler son avion.$"

PokemonJournal_Text_SpecialFeatureErika::
	.string "JOURNAL POKéMON\p"
	.string "Edition spéciale: ARENE DE CELADOPOLE\n"
	.string "ERIKA!\p"
	.string "Si vous arrivez sans prévenir à\n"
	.string "l'Arène de Céladopole,\l"
	.string "vous risquez de la voir dormir.$"

PokemonJournal_Text_SpecialFeatureKoga::
	.string "JOURNAL POKéMON\p"
	.string "Edition spéciale: ARENE DE PARMANIE\n"
	.string "KOGA!\p"
	.string "Il est incollable en médecine.\n"
	.string "On dit qu'il prépare lui-même ses\p"
	.string "médicaments pour soigner ses\n"
	.string "POKéMON.$"

PokemonJournal_Text_SpecialFeatureSabrina::
	.string "JOURNAL POKéMON\p"
	.string "Edition spéciale: ARENE DE SAFRANIA\n"
	.string "MORGANE!\p"
	.string "Les gens racontent qu'elle peut\n"
	.string "communiquer avec ses POKéMON\l"
	.string "pendant les combats juste par la pensée.$"

PokemonJournal_Text_SpecialFeatureBlaine::
	.string "JOURNAL POKéMON\p"
	.string "Edition spéciale: ARENE DE CRAMOIS'ILE\n"
	.string "AUGUSTE!\p"
	.string "Auguste passe tout son temps\n"
	.string "à créer des questions pour son quiz.$"

PokemonJournal_Text_SpecialFeatureLorelei::
	.string "JOURNAL POKéMON\p"
	.string "Edition spéciale:\n"
	.string "OLGA du CONSEIL 4!\p"
	.string "Connue pour sa logique et son\n"
	.string "style de combat très posé.\l"
	.string "Olga cache un terrible secret.$"

PokemonJournal_Text_SpecialFeatureBruno::
	.string "JOURNAL POKéMON\p"
	.string "Edition spéciale :\n"
	.string "ALDO du CONSEIL 4!\p"
	.string "Aldo a rejoint le Conseil 4 pour\n"
	.string "pouvoir affronter les meilleurs\l"
	.string "Dresseurs du monde.$"

PokemonJournal_Text_SpecialFeatureAgatha::
	.string "JOURNAL POKéMON\p"
	.string "Edition spéciale :\n"
	.string "AGATHA du CONSEIL 4!\p"
	.string "Dans sa jeunesse, Agatha était\n"
	.string "la rivale du Prof. Chen.\p"
	.string "Ils s'affrontaient pour obtenir le\n"
	.string "titre du meilleur Dresseur.$"

PokemonJournal_Text_SpecialFeatureLance::
	.string "JOURNAL POKéMON\p"
	.string "Edition spéciale :\n"
	.string "PETER du CONSEIL 4!\p"
	.string "Le grand-père de Peter est\n"
	.string "le doyen du célèbre clan\l"
	.string "des maîtres dragon.$"

PokemonJournal_Text_SpecialFeatureProfOak::
	.string "JOURNAL POKéMON\p"
	.string "Edition spéciale : PROF. CHEN,\n"
	.string "Le professeur POKéMON!\p"
	.string "Le Prof. Chen vit avec\n"
	.string "sa petite-fille Nina et {RIVAL}.$"

PokemonJournal_Text_SpecialFeatureDaisyOak::
	.string "C'est une vieille édition du\n"
	.string "JOURNAL POKéMON…\p"
	.string "JOURNAL POKéMON\n"
	.string "Edition spéciale concours!\p"
	.string "Le grand Champion du concours\n"
	.string "POKéMON de printemps est\l"
	.string "NINA de BOURG PALETTE.$"

PokemonJournal_Text_SpecialFeatureMrFuji::
	.string "JOURNAL POKéMON\p"
	.string "Edition spéciale :\n"
	.string "MR. FUJI de LAVANVILLE!\p"
	.string "Le timide Mr. Fuji a décliné notre\n"
	.string "demande d'interview.\p"
	.string "Cet homme très gentil est\n"
	.string "très apprécié à LAVANVILLE.$"
