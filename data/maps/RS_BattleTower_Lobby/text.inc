BattleTower_Lobby_Text_ScottGaveAuroraTicket::
	.string "Je vais continuer de suivre tes\n"
	.string "exploits à partir de maintenant!$"

BattleTower_Lobby_Text_ScottGaveEonTicket::
	.string "Cette TOUR DE COMBAT a été un\n"
	.string "grand succès mais…\p"
	.string "Il faudrait peut-être pousser\n"
	.string "ce projet encore plus loin…$"
